# Vaultwarden (projects/vaultwarden). `.env` is gitignored everywhere.
#
# On the server this is `${DEPLOY_PATH}/.env`, the root of the environment's checkout,
# two levels above the compose file: the deploy (`_deploy-compose.yml`) passes
# `--env-file "${DEPLOY_PATH}/.env"` explicitly and never rsyncs a `.env`. A `.env`
# beside the compose file is not read there.
#
# Two kinds of line. What is written by hand once, at provisioning, is below. What is a
# secret is NOT written by hand: the deploy writes it from the GitHub Environment secret
# of the same name (`env-secrets` in .github/workflows/deploy-vaultwarden.yml):
#
#   VAULTWARDEN_SMTP_PASSWORD               a Resend API key made for Vaultwarden alone
#   VAULTWARDEN_BACKUP_ACCESS_KEY_ID        the R2 access key pair of the backup, scoped
#   VAULTWARDEN_BACKUP_SECRET_ACCESS_KEY    to its one bucket with Object Read and Write

# The data directory: the database, attachments, sends, config.json and rsa_key*. On the
# host, outside Docker and outside the repository. Required: the compose file has no
# default, so a `.env` that forgets it refuses to start rather than coming up empty.
VAULTWARDEN_DATA_DIR=/srv/rebase-data/vaultwarden

# The host port, always on 127.0.0.1 (the compose file fixes the address): the host's nginx
# is what faces the internet. 8091 is production's row in docs/adding-a-project.md §7.
VAULTWARDEN_PORT=8091

# The public name and the sender of every mail it sends. The sender must be on a domain
# verified in Resend; `vault@` is a sender of its own, apart from the hub's `ciao@`.
VAULTWARDEN_DOMAIN=vault.letsrebase.com
VAULTWARDEN_MAIL_FROM=vault@letsrebase.com

# Who may create an organisation: the owner's address, comma separated if there are two.
# Everyone else can only be invited into `Rebase`.
VAULTWARDEN_ORG_CREATORS=

# The backup (README, "Backup"). The certificate is the PUBLIC half of the backup key
# pair, as one line of base64: `base64 -w0 < vaultwarden-backup.crt`. The private half
# never comes to this host. The account id is Cloudflare's, not a secret; the bucket is
# the one infra/cloudflare/r2.tf creates.
VAULTWARDEN_BACKUP_CERT_B64=
VAULTWARDEN_BACKUP_R2_ACCOUNT_ID=
VAULTWARDEN_BACKUP_BUCKET=rebase-vaultwarden-backup
# When the daily backup runs, UTC.
VAULTWARDEN_BACKUP_AT=03:30

# The admin page is OFF while this line is absent. Put it here only for the minutes a
# person needs the page, then delete the line and re-run the deploy (README, "The admin
# page"). The value is an Argon2id hash from `vaultwarden hash`, never the token, and it
# is in SINGLE quotes: the hash is full of `$`, which compose would otherwise read as
# variables.
# VAULTWARDEN_ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'
