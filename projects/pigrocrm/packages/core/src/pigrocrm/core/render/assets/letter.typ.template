// The page of a framework agreement or an engagement letter. A pandoc Typst template: a name
// between dollar signs is a variable and `$$body$$` is the text after pandoc's Typst writer
// (dollars are doubled in comments, because pandoc substitutes there too).
//
// A contract is printed, signed and filed: the page is white, the text is justified with Italian
// hyphenation, and the issuer is a name in type, not a picture (the space's legal entity, which
// `pigrocrm.core.collaborators.letter_pdf` passes as `issuer`).
//
// `letter_pdf` rewrites three things in the body before Typst sees it: a field the data left
// empty becomes `field("label")` (a blank line labelled with the field), a proposal still to be
// decided becomes `proposal[...]`, and every `field` whose name starts with `firma`, or is
// `data firma`, is a blank the signing site fills: it leaves a `metadata` labelled
// `<signature-blank>` with its page and box, in points from the page's top-left corner, which
// `letter_pdf.signature_blanks` reads back with `typst query`.

#let ink = rgb("#111b2e")
#let inkquiet = rgb("#4a5568")
#let accent = rgb("#c8372d")
#let gold = rgb("#b8860b")
#let gridline = rgb("#cbd5e0")

#let draft = $draft$

// The copy that goes out for signature: the labels under the blanks the signing site fills are
// laid out and left undrawn, so the signature and the date do not sit on them and every blank
// keeps its place.
#let for-signing = $forsigning$

// A blank to fill in: a rule with the field's name under the reader's pen. A signature gets the
// room a pen needs above its rule, and a blank the signing site fills carries a `<signing-blank>`
// marker (its name and size, known at once) nested inside the box's own frame. The marker's page
// and position are read only once, by the `context` after `$$body$$`, when the whole document
// (and every table's row heights) is already laid out.
#let signing(name) = name.starts-with("firma") or name == "data firma"
#let field(name) = context {
  let signature = name.starts-with("firma")
  let label = text(size: 0.75em, fill: inkquiet, name)
  let width = calc.max(measure(label).width + 6pt, if signature { 55mm } else { 30mm })
  let stroke = (bottom: 0.6pt + inkquiet)
  let inset = (x: 2pt, top: if signature { 16pt } else { 0pt }, bottom: 1.5pt)
  if not signing(name) {
    box(width: width, stroke: stroke, inset: inset, label)
  } else {
    let size = measure(box(width: width, stroke: stroke, inset: inset, label))
    let mark = metadata((name: name, width: size.width.pt(), height: size.height.pt()))
    let shown = if for-signing { hide(label) } else { label }
    box(width: width, stroke: stroke, inset: inset, [#mark<signing-blank>] + shown)
  }
}
#let proposal(body) = highlight(fill: gold.lighten(45%), extent: 1pt, body)

#set document(title: "$title$")

#set page(
  paper: "a4",
  margin: (x: 24mm, top: 26mm, bottom: 24mm),
  fill: white,
  background: if draft {
    rotate(-40deg, text(size: 120pt, weight: 500, fill: ink.transparentize(95%), "BOZZA"))
  },
  header: context {
    if counter(page).get().first() > 1 {
      set text(size: 8pt, fill: inkquiet)
      grid(
        columns: (1fr, auto),
        [$issuer$ · $title$],
        [Versione $version$#if draft [ · bozza]],
      )
    }
  },
  footer: context {
    set text(size: 8pt, fill: inkquiet)
    align(right)[Pagina #counter(page).display() di #counter(page).final().first()]
  },
)

#set text(font: ("$mainfont$",), size: 10pt, fill: ink, lang: "it", hyphenate: true)
#set par(leading: 0.6em, spacing: 0.95em, justify: true)
#show strong: set text(weight: "semibold")
#set list(indent: 4pt, body-indent: 6pt)
#set enum(indent: 4pt, body-indent: 6pt)

// An article title keeps the accent square before it, and stays with the paragraph under it: a
// title alone at the foot of a page reads as a clause that was left out.
#show heading.where(level: 1): it => block(above: 1.6em, below: 0.8em, sticky: true)[
  #box(rect(width: 5pt, height: 5pt, fill: accent, stroke: none))
  #h(5pt)
  #text(size: 11.5pt, weight: "semibold", it.body)
]

// The tables here are a handful of rows (the numbers of an engagement, the signatures), and half
// a table at the foot of a page reads as a missing term: they stay whole. Pandoc centres every
// table and passes `align: auto` per column, which inherits that centring into the cells, so the
// cells are set back to the left edge here.
#show figure.where(kind: table): set block(breakable: false)
#set table(stroke: 0.5pt + gridline, inset: (x: 6pt, y: 6pt))
#show table.cell: set align(left + horizon)
#show table.cell.where(y: 0): set text(weight: "semibold")

#block(below: 1.8em)[
  #text(size: 9pt, fill: inkquiet)[$issuer$]
  #v(8pt)
  #text(size: 22pt, weight: "semibold")[$title$]
  $if(subtitle)$
  #v(2pt)
  #text(size: 11pt, fill: inkquiet)[$subtitle$]
  $endif$
  #v(6pt)
  #text(size: 8.5pt, fill: inkquiet)[Versione $version$ · $date$#if draft [ · bozza]]
  #if draft {
    v(10pt)
    block(
      width: 100%,
      fill: gold.lighten(85%),
      stroke: (left: 2pt + gold),
      inset: 8pt,
      text(size: 8.5pt)[
        *Bozza da rivedere.* Il testo evidenziato così, #proposal[15%], è una proposta ancora
        da decidere. Una riga con un'etichetta, #field("partita iva"), è un dato da compilare
        per ogni firma.
      ],
    )
  }
]

$body$

// Every `<signing-blank>` marker, resolved into the `<signature-blank>` position
// `signature_blanks` reads with `typst query`: by now the whole document, including every
// table's row heights, is laid out, so `.location().position()` gives the real page and point.
#context for it in query(<signing-blank>) {
  let pos = it.location().position()
  let value = it.value
  [#metadata((
    name: value.name,
    page: pos.page,
    x: pos.x.pt(),
    y: pos.y.pt(),
    width: value.width,
    height: value.height,
  ))<signature-blank>]
}
