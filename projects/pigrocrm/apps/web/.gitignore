# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# node_modules/, dist/ and *.tsbuildinfo are already covered by the repo-root .gitignore.
dist-ssr
dist-landing
*.local

# Regenerated by @tanstack/router-plugin on every dev/build/test run; committing
# them just invites merge conflicts on files nothing should hand-edit.
src/routeTree.gen.ts
.tanstack/

# Playwright (apps/web/e2e): run artifacts, never source -- regenerated by every
# `pnpm exec playwright test` / `pnpm test:e2e` invocation.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
