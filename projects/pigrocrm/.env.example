# Local development environment for the PigroCRM API (packages/core/src/pigrocrm/core/config.py)
# and for `docker compose`. `.env` is already in .gitignore, so a local secret never ends
# up in a commit.
#
# Where the copy lives depends on who reads it:
#   * for `uv run uvicorn ...` / `uv run pytest`, in the repository root, where those
#     commands run by this repository's own convention: `Settings` (pydantic-settings)
#     loads `.env` from the current working directory on its own, no extra
#     configuration needed.
#   * for `docker compose`, in `projects/pigrocrm/`, beside this file and beside
#     docker-compose.yml: compose reads `.env` from the directory of its own compose
#     file, never from the repository root.
#   * on a server, `${DEPLOY_PATH}/.env`, the root of the environment's checkout, two
#     levels above the compose file. The deploy (`_deploy-compose.yml`) passes
#     `--env-file "${DEPLOY_PATH}/.env"` explicitly and never rsyncs a `.env`, so each
#     environment keeps its own. A `.env` beside the compose file is not read there.

PIGROCRM_DATABASE_URL=postgresql+psycopg://pigrocrm:pigrocrm@localhost:5432/pigrocrm
# Local development only: any string at least 32 characters long (Settings
# rejects it at start-up if shorter, RFC 7518 §3.2). In production it has to be a real
# secret, never this value.
PIGROCRM_JWT_SECRET=cambia-questo-con-un-segreto-vero-di-almeno-32-caratteri

# Six months, sliding: `/api/auth/refresh` consumes the old jti and issues a
# new one whose expiry is measured from now, so someone who uses the CRM never sees the
# login screen again and someone who leaves it alone for six months does (slice 9 §5.6). The
# access token stays at fifteen minutes: that's the revocation window, not the session duration.
PIGROCRM_REFRESH_TOKEN_DAYS=180

# Same 180 days as above, on purpose (design 2026-09-23 §2, REB-376): the
# cross-space identity cookie is meant to outlive any single space's own session,
# so it is exactly as much a per-installation choice as PIGROCRM_REFRESH_TOKEN_DAYS.
PIGROCRM_IDENTITY_TOKEN_DAYS=180

# Lets the Orbiters hub read the list of spaces: `GET /api/tenants/` answers whoever
# presents this value as a bearer token with every registry row (slug, owner, date), and
# the hub's admin area shows them (ORB-142). Leave it empty and the route does not exist,
# which is the right answer for a self-hosted installation. On the server it is a secret,
# generated once (`openssl rand -hex 32`) and set identically as REBASE_PIGRO_REGISTRY_TOKEN
# in the hub's own `.env`.
PIGROCRM_REGISTRY_TOKEN=
# Where the Orbiters hub answers. The signup asks it whether an address belongs to a
# community member (`GET /api/hub/members/lookup`, ORB-173), presenting the same
# PIGROCRM_REGISTRY_TOKEN above as a bearer: one value on both hosts, and since ORB-173 it
# travels in both directions. Hub unreachable, token empty or refused: the person is
# treated as not a member and the signup goes on. Default `https://letsrebase.com`.
PIGROCRM_HUB_URL=https://letsrebase.com

# --- Outbound mail (spec 2026-09-12 §6.1). Resend sends the login link («Mandami il
# link») and the welcome mail of a new space. Leave the key empty and the CRM sends
# nothing: those endpoints answer 503 with a sentence, the password login still works.
# The sender must be on a domain Resend verified; letsrebase.com already is.
PIGROCRM_RESEND_API_KEY=
PIGROCRM_MAIL_FROM=PigroCRM <ciao@letsrebase.com>

# --- Product analytics (ORB-186) -----------------------------------------------------
# The MCP server reports every tool call to PostHog when this holds the project key: the
# public `phc_...` of the one project every Orbiters surface writes to, the same value
# `shared/analytics/posthog.ts` carries for the browsers. It is a project key, not a
# personal one: it can only write events. Empty, the installation measures nothing,
# which is the right default for a self-hosted CRM. The host is Cloud EU.
PIGROCRM_POSTHOG_KEY=
PIGROCRM_POSTHOG_HOST=https://eu.i.posthog.com
# The API also sends one `digest_inviato` event per recipient from the server itself
# (core/telemetry.py, REB-221): set this key on the server too, or the Monday report
# is never counted.

# Why this line exists and is `false` ONLY here:
# Vite's dev proxy (apps/web/vite.config.ts) serves the dev API over plain
# http://localhost, without TLS. Chrome and Firefox treat "localhost" as a secure
# context and still send a `Secure` cookie over HTTP in that case -- but Safari doesn't,
# and has no plan to. With the production default (`cookie_secure=true`,
# see the comment on Settings.cookie_secure in packages/core/src/pigrocrm/core/config.py)
# left active here, login on Safari in development would still answer 200 while
# the browser silently drops the cookie: every following request would come back
# "unauthenticated", without a single visible error in any log to explain why.
#
# Do NOT set this variable to `false` in production thinking it's a formality:
# there the API sits behind real TLS, and `Secure` is the only thing that stops
# whoever is intercepting an unencrypted network from replaying the captured cookie.
PIGROCRM_COOKIE_SECURE=false

# --- Gmail (slice 5). Leave PIGROCRM_GOOGLE_CLIENT_ID empty to run without Gmail:
# it's not a broken feature, it's an absent one. The interface hides the section,
# the endpoints answer Conflict and the MCP tools aren't even registered.
# That's what lets someone self-hosting specifically to avoid Google not have it.
# Set all four or none: a client id without an encryption key would
# connect an account and then fail to save its refresh token.
PIGROCRM_GOOGLE_CLIENT_ID=
PIGROCRM_GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
# Exactly 32 bytes: encrypts `google_accounts.refresh_token_ciphertext` at rest (AES-256-GCM).
# Lives outside the database on purpose -- a dump, a backup or a pg_dump attached to a
# bug report are exposure surfaces different from the running system, and
# this credential unlocks a *third-party* account, not just this application.
PIGROCRM_GOOGLE_TOKEN_KEY=
# The public origin. Google compares {PIGROCRM_PUBLIC_URL}/api/gmail/oauth/callback
# with the authorized redirect URI character by character.
PIGROCRM_PUBLIC_URL=
# `true` until the OAuth client is verified (Testing status): in that case the refresh
# token of a consumer account expires 7 days after consent, and the interface warns
# 48 hours before. Google doesn't expose an API to know this, so whoever installs it declares it.
PIGROCRM_GOOGLE_APP_UNVERIFIED=false
# `true` lends the client above to every space that has none of its own (REB-394), so
# «Collega Gmail» in a space works without its own OAuth client. A space's consent comes
# back to {PIGROCRM_PUBLIC_URL}/api/gmail/oauth/callback (and /api/drive/oauth/callback),
# the root's own addresses, and the root relays it to the space named in the state.
# Each space's refresh tokens are sealed with a key derived from PIGROCRM_GOOGLE_TOKEN_KEY
# and the space's name, so rotating that key reconnects every space as well as the root.
PIGROCRM_GOOGLE_SHARED_CLIENT=false

# --- MCP surface -------------------------------------------------------------
# Whether a personal token (PAT) can also perform the operations listed in
# `packages/core/src/pigrocrm/core/actor.py::AGENT_FORBIDDEN_ACTIONS` -- issuing and
# cancelling invoices, rates, cost categories, period closings, the hours-to-invoice
# bridge and the annual estimate. (The fiscal profile and the emitter are not on that
# list: an admin's token writes them on every installation, ORB-188.)
#
# `false` is the default, and it's the default nobody needs to know about to be safe.
# Those operations aren't just privileged: they're **irreversible in a way the
# rest of the product isn't**. Issuing an invoice consumes a number from a fiscal register with no
# gaps, which can't be given back; a sent email sits in someone else's inbox.
# The worst outcome isn't "the agent got it wrong", it's "the agent got it wrong and it can't
# be undone".
#
# Setting it to `true` is a decision about *this* installation, and it's legitimate: the product
# is single-tenant and self-hosted, and whoever uses it can reasonably want their own
# agent to do everything they themselves do. The value is read once, in
# `PatService.resolve`, and stamped onto the credential -- so it holds identically on MCP and on
# REST, which is what stops the two adapters from saying different things about the same token.
#
# It doesn't replace the role: a `readonly` user's token stays read-only.

# The same switch governs the HTTP transport (the `mcp` compose service): a token is
# resolved with the space's settings applied, so a space decides for itself in
# Impostazioni -> Spazio and the root decides here.

# ---------------------------------------------------------------------------
# From here down: only for `docker compose up` (docker-compose.yml), not for
# local development above. `docker compose` automatically loads a copy of this
# file placed in `projects/pigrocrm/.env`, beside docker-compose.yml itself (or, on
# a server, the one at `${DEPLOY_PATH}/.env` that `--env-file` names explicitly --
# see the header above), to substitute the `${...}` in the compose file itself. It
# doesn't, however, inject it into the containers: each service only receives the variables its
# `environment:` block explicitly names. That's why the two sections of
# this same file can coexist without clashing:
#
# - PIGROCRM_DATABASE_URL above points to a local Postgres on localhost:5432, for
#   whoever runs `uv run uvicorn`/`uv run pytest` directly on the host. The
#   compose stack's `api` container completely ignores this value: it builds
#   its own URL from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below,
#   pointed at the internal network host `db`, not at `localhost`.
# - PIGROCRM_JWT_SECRET above is the same variable the `api` container receives:
#   a single secret, for both flows. If you generate it with `openssl rand -hex 32`
#   for local development, generate a **different** secret (and never commit it) before
#   using this file for a real deploy.
# - PIGROCRM_COOKIE_SECURE above stays `false` for local development, but
#   docker-compose.yml doesn't pass it to the `api` container -- on purpose, with the
#   reason spelled out there. `docker compose up` therefore always receives Settings'
#   safe default (`cookie_secure=True`), whatever this file says. For that
#   default to actually work (for the browser to keep the cookie
#   instead of dropping it) the real server has to genuinely terminate TLS --
#   deploy/setup-server.sh configures nginx on the host, but the certificate
#   (`certbot --nginx -d "$PIGROCRM_DOMAIN"`) stays a manual, one-time step.

# Credentials for the Postgres managed by compose (service `db`, volume
# `pigrocrm-db`): not whatever might be listening on localhost:5432 for
# direct development above. Required: without a password compose refuses to
# start (`${POSTGRES_PASSWORD:?serve una password}` in docker-compose.yml).
POSTGRES_USER=pigrocrm
POSTGRES_PASSWORD=
POSTGRES_DB=pigrocrm

# Where the Postgres data lives on the host (outside Docker, outside the repository).
# A Docker Desktop reset must not be able to delete the fiscal register. Required: no
# default in docker-compose.yml, so a `.env` that forgets it fails the stack rather
# than starting on an empty directory (REB-258).
PIGROCRM_DATA_DIR=/percorso/assoluto/pigrocrm-data/postgres
# Address:port of the host on which to expose Postgres (loopback only by default).
PIGROCRM_DB_PORT=127.0.0.1:55432

# Where `PIGROCRM_STORAGE_BACKEND=local` writes documents on the host, outside Docker,
# so a rebuilt container keeps every PDF; optional, defaults in docker-compose.yml to
# `../../var/documents` (the repository's own `var/documents`, two levels above this
# compose file).
PIGROCRM_DOCUMENTS_DIR=../../var/documents
# Address:port of the host on which to expose the web container's nginx (loopback
# only by default): overridable so a second environment (preview) can run the same
# stack on the same host without fighting for the port.
PIGROCRM_WEB_PORT=127.0.0.1:8080

# --- preview ---------------------------------------------------------------------------
# The preview stack (`-p pigrocrm-preview`) is the same file at its own `${DEPLOY_PATH}`,
# with its own password, its own two directories and the preview's own two ports
# (docs/adding-a-project.md §7's table: web 8081, Postgres 55434 for the CRM preview).
# POSTGRES_PASSWORD=<its own>
# PIGROCRM_DATA_DIR=/srv/pigrocrm-preview-data/postgres
# PIGROCRM_DOCUMENTS_DIR=/srv/pigrocrm-preview-data/documents
# PIGROCRM_DB_PORT=127.0.0.1:55434
# PIGROCRM_WEB_PORT=127.0.0.1:8081
