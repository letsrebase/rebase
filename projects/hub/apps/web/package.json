{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "letsrebase.com/hub: the rebase wizards for freelancers and companies, and the admin area that reads them.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "generate:api": "uv run --frozen python scripts/dump-openapi.py | openapi-typescript -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@rebase/analytics": "workspace:*",
    "@rebase/brand": "workspace:*",
    "@rebase/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "^1.62.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
