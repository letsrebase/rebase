FROM node:24-bookworm-slim AS build

# The build context is the repository root: the pnpm workspace root, the single
# lockfile and the three `shared/` packages the hub imports live above this project.
# `package.json` is copied before `corepack enable`, so corepack reads `packageManager`
# from it.
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN corepack enable
COPY projects/hub/apps/web/package.json projects/hub/apps/web/
COPY shared/brand/package.json shared/brand/
COPY shared/analytics/package.json shared/analytics/
COPY shared/ui/package.json shared/ui/
RUN --mount=type=cache,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store --filter hub...

COPY shared/brand ./shared/brand
COPY shared/analytics ./shared/analytics
COPY shared/ui ./shared/ui
# The amount and rate cases the hub's tests share with the website: `build` type-checks
# the tests too, so the fixture has to be in the image.
COPY shared/format-cases ./shared/format-cases
COPY projects/hub/apps/web ./projects/hub/apps/web
RUN pnpm --filter hub build

FROM nginxinc/nginx-unprivileged:1.31-alpine
# The unprivileged build of the same nginx (user `nginx`, port 8080): the container has no
# root process. `apk upgrade` as root for that one layer, for the reason given in
# projects/pigrocrm/Dockerfile.web.
USER root
RUN apk upgrade --no-cache
USER nginx
COPY --from=build /app/projects/hub/apps/web/dist /usr/share/nginx/html/hub
COPY projects/hub/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
