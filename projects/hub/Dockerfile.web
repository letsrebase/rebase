FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@11.6.0 --activate
WORKDIR /app

# The build context is the repository root: the pnpm workspace root, the single
# lockfile and the three `shared/` packages the hub imports live above this project.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY projects/hub/apps/web/package.json projects/hub/apps/web/
COPY shared/brand/package.json shared/brand/
COPY shared/analytics/package.json shared/analytics/
COPY shared/ui/package.json shared/ui/
RUN pnpm install --frozen-lockfile --filter hub...

COPY shared/brand ./shared/brand
COPY shared/analytics ./shared/analytics
COPY shared/ui ./shared/ui
COPY projects/hub/apps/web ./projects/hub/apps/web
RUN pnpm --filter hub build

FROM nginx:1.27-alpine
COPY --from=build /app/projects/hub/apps/web/dist /usr/share/nginx/html/hub
COPY projects/hub/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
