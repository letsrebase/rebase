# The build context is the repository root: the uv workspace (pyproject.toml, uv.lock) lives
# there, shared by every Python project. Two stages, as projects/pigrocrm/Dockerfile.api:
# `build` installs the virtualenv with uv, `runtime` is Python, the contract renderer and the
# finished /app, with no build cache in it.

FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

FROM python:3.13-slim-trixie AS build

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1

WORKDIR /app
# Every workspace member's pyproject has to be present for the resolution step, PigroCRM's
# included (uv refuses a workspace with a member missing), but only this project's closure
# is installed.
COPY pyproject.toml uv.lock ./
COPY projects/pigrocrm/packages/core/pyproject.toml projects/pigrocrm/packages/core/
COPY projects/pigrocrm/apps/api/pyproject.toml projects/pigrocrm/apps/api/
COPY projects/pigrocrm/apps/mcp/pyproject.toml projects/pigrocrm/apps/mcp/
COPY projects/hub/packages/core/pyproject.toml projects/hub/packages/core/
COPY projects/hub/apps/api/pyproject.toml projects/hub/apps/api/
COPY projects/hub/apps/mcp/pyproject.toml projects/hub/apps/mcp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package rebase-api --package rebase-mcp

COPY projects/hub/packages ./projects/hub/packages
# The palette, the typeface and the echo logo a contract is typeset in, at the paths
# `rebase_core.contracts.brand` reads them from: the image mirrors the repository.
COPY shared/brand/palette.css shared/brand/palette.css
COPY shared/brand/fonts/outfit-variable-latin.woff2 shared/brand/fonts/outfit-variable-latin.woff2
COPY shared/brand/echo/echo-ink-watermelon-outlines-260.png shared/brand/echo/echo-ink-watermelon-outlines-260.png
COPY projects/hub/apps/api ./projects/hub/apps/api
COPY projects/hub/apps/mcp ./projects/hub/apps/mcp
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package rebase-api --package rebase-mcp


FROM python:3.13-slim-trixie AS runtime

# The anonymous CV is printed at request time (REB-862) with the Typst PigroCRM's renderer was
# verified against, downloaded and checked against its SHA-256 as projects/pigrocrm/Dockerfile.api
# does. Pandoc is not here: only the guide build (tools/build_guide_pdf.py) runs it, on a laptop
# or in CI, never in this image (REB-1108). `packages/core/tests/test_api_image.py` fails when
# the two files name different Typst pins; a bump changes the two lines in both.
ARG TYPST_VERSION=0.14.2
ARG TYPST_SHA256=a6044cbad2a954deb921167e257e120ac0a16b20339ec01121194ff9d394996d

# No libpq5: `psycopg[binary]` carries its own.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && curl -fsSL -o /tmp/typst.tar.xz "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
    && echo "${TYPST_SHA256}  /tmp/typst.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/typst.tar.xz -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && chmod +x /usr/local/bin/typst \
    && apt-get purge -y curl xz-utils && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/*

# `uv` stays for the operator: every runbook, the host's crontab and `docker exec` one-offs run
# `uv run --no-sync <command>` in the container. The service commands do not use it.
COPY --from=uv /uv /usr/local/bin/uv

RUN useradd --system --uid 10001 --user-group --no-create-home --home-dir /nonexistent app

WORKDIR /app
COPY --from=build /app /app

# The image's own virtualenv first on the PATH, so `uvicorn`, `alembic` and `rebase` are the
# ones uv installed and no `uv run` is needed at start: without `--no-sync` it would sync the
# dev group over the network at every container start. `XDG_CACHE_HOME` points at
# /tmp, the one writable path of a container run read-only.
ENV PATH="/app/.venv/bin:${PATH}" XDG_CACHE_HOME=/tmp PYTHONUNBUFFERED=1

USER app
EXPOSE 8000
# Migrations at start-up, one instance, then `exec` so uvicorn is the container's own process
# (under `init: true`) and a SIGTERM reaches it instead of costing every deploy the 10 s kill
# timeout.
CMD ["sh", "-c", "cd projects/hub/packages/core && alembic upgrade head && cd /app && exec uvicorn rebase_api.main:app --host 0.0.0.0 --port 8000"]
