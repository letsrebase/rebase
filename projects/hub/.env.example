# The rebase hub (projects/hub). `.env` is gitignored everywhere.
#
# Where the file lives depends on who reads it:
#   * locally, `projects/hub/.env`, beside this file: compose reads it from the directory
#     of its own compose file, and `uv run --env-file projects/hub/.env` reads the same.
#   * on a server, `${DEPLOY_PATH}/.env`, the root of the environment's checkout, two
#     levels above the compose file. The deploy (`_deploy-compose.yml`) passes
#     `--env-file "${DEPLOY_PATH}/.env"` explicitly and never rsyncs a `.env`, so each
#     environment keeps its own. A `.env` beside the compose file is not read there.

# Local development: the hub's own Postgres, never PigroCRM's.
REBASE_DATABASE_URL=postgresql+psycopg://rebase:rebase@localhost:55435/rebase

# --- ChatGPT Ads: the signup conversion ---------------------------------------------
# The pixel id is public (it sits in the website's markup); the key is a secret with
# write access to the conversion source and belongs in this file on the server only.
# Leave both empty and no server event is sent. Check the key without inventing a
# conversion:  docker compose -p rebase exec api uv run --no-sync rebase conversions-check
REBASE_OPENAI_PIXEL_ID=
REBASE_OPENAI_CONVERSIONS_API_KEY=
REBASE_SIGNUP_URL=https://letsrebase.com/
REBASE_OPENAI_CONVERSIONS_SEND_HASHED_EMAIL=false

# --- PostHog: the completion event, from the server (REB-215) ------------------------
# The browsers report the wizard's steps; the API reports `iscrizione_completata` itself,
# because the browser's event is the one an ad blocker eats. The key is the public
# project key, the same one `shared/analytics/posthog.ts` carries. Empty: no client, no
# event. Preview sends too, marked internal by the browser side already.
REBASE_POSTHOG_KEY=
REBASE_POSTHOG_HOST=https://eu.i.posthog.com

# --- the member area: the magic link by mail ------------------------------------------
# Resend sends the login link. Empty key: the link request answers 503 with a sentence
# and nothing pretends to send. The key is a secret and lives in this file on the
# server only; the SPF and DKIM records for letsrebase.com are set in Resend's panel.
REBASE_RESEND_API_KEY=
REBASE_MAIL_FROM=Rebase <ciao@letsrebase.com>
# Where the SPA answers, for the link in the mail. Local development:
# `http://localhost:5180/hub`, the Vite dev server.
REBASE_HUB_URL=https://letsrebase.com/hub

# --- PigroCRM's spaces in the admin area --------------------------------------------
# «Istanze Pigro» asks the CRM's API which spaces exist and whose they are, with the
# same value PigroCRM's `.env` carries as PIGROCRM_REGISTRY_TOKEN (ORB-142). Empty token:
# the page says the registry is not configured. Never the CRM's database URL: the hub
# does not touch it. Locally, point the URL at a CRM API you run (`http://localhost:8000`).
REBASE_PIGRO_API_URL=https://pigro.letsrebase.com
REBASE_PIGRO_REGISTRY_TOKEN=

# --- the contracts (REB-387) ---------------------------------------------------------
# Who signs for rebase, as the `rebase-*` fields of the framework agreement and the
# letter: one JSON object on one line, in single quotes so the double quotes survive.
# Read over the package's own `rebase.json`, whose nulls wait for the SRL (roadmap #284).
# Empty: those fields print as blank lines, fine for a preview. Never in the repository.
# REBASE_SIGNER_JSON='{"rebase-rappresentante": "Nome Cognome", "rebase-sede": "Milano"}'
REBASE_SIGNER_JSON=

# --- the signing site: Documenso (REB-387) -------------------------------------------
# One Documenso instance runs beside production (REB-393); each environment signs through
# a Documenso user of its own, with its own team, API token and webhook, made by hand in
# Documenso's UI (probe § 3 and § 8).
#   production: REBASE_DOCUMENSO_URL=http://documenso:3000 (the compose service)
#   preview:    REBASE_DOCUMENSO_URL=https://firma.letsrebase.com
# Empty URL or token: «Invia per la firma» answers 503 with a sentence. Empty secret: the
# webhook answers 503. The secret is the value typed into the webhook's form.
REBASE_DOCUMENSO_URL=
REBASE_DOCUMENSO_API_TOKEN=
REBASE_DOCUMENSO_WEBHOOK_SECRET=
# Where rebase's copy of every signed contract is mailed.
REBASE_CONTRACTS_MAIL=ciao@letsrebase.com
# A text still `status: draft` never leaves for signature. Only the preview's own `.env`
# sets this true, to send a text still being drafted end to end; with both texts
# `status: final` the preview leaves it false too, and it waits for the next draft.
REBASE_CONTRACTS_ALLOW_DRAFT=false

# --- campaigns (P-REB-41) ----------------------------------------------------------------
# The sender of a campaign mail, the gap in days between two campaigns to one person, and
# the `whsec_` secret Resend shows when this environment's webhook is created (AGENTS.md
# «Campaigns»). Without the secret the webhook answers 503.
REBASE_CAMPAIGN_FROM=Ivan di rebase <ciao@letsrebase.com>
REBASE_CAMPAIGN_GAP_DAYS=3
REBASE_RESEND_WEBHOOK_SECRET=
# --- Claude: the team builder's seam (llm.py, REB-508) -------------------------------
# The anonymous card and the team proposal go through Anthropic's API, in the EU. Empty
# key: no card is written and the builder answers 503 with a sentence; nothing else of
# the hub changes. The key is a secret and lives in this file on the server only.
REBASE_ANTHROPIC_API_KEY=
REBASE_TEAM_BUILDER_MODEL=claude-opus-5
REBASE_TEAM_BUILDER_ENABLED=true

# --- docker compose only -------------------------------------------------------------
POSTGRES_USER=rebase
POSTGRES_PASSWORD=
POSTGRES_DB=rebase
# Postgres data on the host, outside Docker and outside the repository. Required: the
# compose file has no default for it, so a stack whose `.env` forgets it refuses to
# start rather than coming up on an empty directory, or on another stack's data.
REBASE_DATA_DIR=/absolute/path/to/rebase-data/postgres
# Host ports, loopback only: the host's nginx is what faces the internet. These are
# production's (`docs/adding-a-project.md` §7 has the table for every project).
REBASE_DB_PORT=127.0.0.1:55435
REBASE_API_PORT=127.0.0.1:8084
REBASE_WEB_PORT=127.0.0.1:8085
# The MCP server over HTTP (REB-213), proxied by the host at /api/hub/mcp.
REBASE_MCP_PORT=127.0.0.1:8088

# --- Documenso, the signing site (REB-393), production only -----------------------------
# Documenso runs in this compose project from a file of its own, which only production's
# `.env` loads (compose interpolates every service of every file it reads, so the
# preview's deploy and CI's build must never see it):
# COMPOSE_FILE=docker-compose.yml:docker-compose.documenso.yml
# The preview signs on production's instance through a Documenso user of its own and sets
# none of what follows. Each secret is `openssl rand -hex 32`, the database password
# `openssl rand -hex 24` (a URL carries it); the certificate is the `.p12` made on the
# host, as one line of base64 (AGENTS.md). Documenso mails through REBASE_RESEND_API_KEY.
# What the hub itself reads to reach Documenso (REBASE_DOCUMENSO_URL and the rest) is the
# block above, "the signing site: Documenso (REB-387)": these variables are Documenso's
# own container settings, read by nothing in this repository's Python.
# REBASE_DOCUMENSO_DATA_DIR=/srv/rebase-data/documenso-postgres
# REBASE_DOCUMENSO_PORT=127.0.0.1:8090
# DOCUMENSO_PUBLIC_URL=https://firma.letsrebase.com
# DOCUMENSO_DB_PASSWORD=
# DOCUMENSO_NEXTAUTH_SECRET=
# DOCUMENSO_ENCRYPTION_KEY=
# DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# DOCUMENSO_SIGNING_CERT_BASE64=
# DOCUMENSO_SIGNING_PASSPHRASE=
# DOCUMENSO_MAIL_FROM=ciao@letsrebase.com
# Open (false) only for the minutes the two environments' users take; true otherwise:
# DOCUMENSO_DISABLE_SIGNUP=true
# Server-side too, whether or not the line above is open: a signup outside these domains
# is refused (NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS in the image). Both planned users are
# @letsrebase.com, which is the default; change it only for a domain neither uses.
# DOCUMENSO_SIGNUP_DOMAINS=letsrebase.com
# Production's webhook calls the API by its compose name; a local run calls the host:
# DOCUMENSO_WEBHOOK_BYPASS_HOSTS=api

# --- preview ---------------------------------------------------------------------------
# The preview stack (`-p rebase-preview`) is the same file at its own `${DEPLOY_PATH}`,
# with its own password, its own data directory and the next three ports. It sends no
# conversion, so the pixel key stays empty there.
# POSTGRES_PASSWORD=<its own>
# REBASE_DATA_DIR=/srv/rebase-preview-data/postgres
# REBASE_DB_PORT=127.0.0.1:55436
# REBASE_API_PORT=127.0.0.1:8086
# REBASE_WEB_PORT=127.0.0.1:8087
# REBASE_MCP_PORT=127.0.0.1:8089
# REBASE_OPENAI_CONVERSIONS_API_KEY=
