.claude/settings.local.json
.claude/worktrees/
.reference-*/
.superpowers/
# direnv's per-checkout cache of the flake's shell, and `nix build`'s result links,
# anchored: a source file named `result` is not a build output
.direnv/
/result
/result-*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Node
node_modules/
dist/
*.tsbuildinfo
# Playwright's run state and its per-failure artefact directories. It rewrites
# `test-results/.last-run.json` on every run and drops a `test-results/<test>/`
# with an `error-context.md` for every failure, so without this line a finished
# e2e run leaves a modified tracked file and untracked directories that are
# nobody's work, and `git add -A` ships a test run's timestamp to the trunk.
test-results/

# Env
.env
.env.local

# Storage locale dei documenti (LocalFileStorage)
var/
# Postgres data if an installation points PIGROCRM_DATA_DIR inside the checkout
data/

# Playwright MCP snapshots and console logs written while I look at pages
.playwright-mcp/
# Screenshots I take while reviewing pages
*.png
!**/public/*.png
# The site's share card, drawn by projects/website/scripts/share-card.mjs and
# committed: it sits a directory deeper because nginx serves /assets and nothing
# else at the root (ORB-112).
!projects/website/src/public/assets/*.png
# The echo logo, drawn by shared/brand/tools/build-echo.mjs and committed (ORB-200).
!shared/brand/echo/*.png
# A rendered contact sheet beside a design record, the evidence for its rows (REB-298).
!docs/design/**/*.png
