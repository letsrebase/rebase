        expires: '2026-11-06T00:00:00.000Z'
  SNYK-DEBIAN13-ZLIB-19520500:
    - '*':
        reason: "No fix yet (REB-540). Debian's security tracker lists CVE-2026-85091 (zlib) as vulnerable for trixie on 2026-10-06, and a fresh python:3.13-slim-trixie has no newer zlib1g to install. Look again when Debian ships a fix."
        expires: '2026-11-06T00:00:00.000Z'
  SNYK-DEBIAN13-GCC14-20335537:
    - '*':
        reason: "No fix yet (REB-540). Debian's security tracker lists CVE-2026-102010 (gcc-14) as vulnerable for trixie on 2026-10-06, and a fresh python:3.13-slim-trixie has no newer gcc-14-base to install. Look again when Debian ships a fix."
        expires: '2026-11-06T00:00:00.000Z'
  SNYK-DEBIAN13-GCC14-20386241:
    - '*':
        reason: "No fix yet (REB-540). Debian's security tracker lists CVE-2026-95619 (gcc-14) as vulnerable for trixie on 2026-10-06, and a fresh python:3.13-slim-trixie has no newer gcc-14-base to install. Look again when Debian ships a fix."
        expires: '2026-11-06T00:00:00.000Z'
  SNYK-DEBIAN13-EXPAT-19964593:
    - '*':
        reason: "No fix yet (REB-540). Debian's security tracker lists CVE-2026-93990 (expat) as vulnerable for trixie on 2026-10-06, and a fresh python:3.13-slim-trixie has no newer libexpat1 to install. Look again when Debian ships a fix."
        expires: '2026-11-06T00:00:00.000Z'
  SNYK-DEBIAN13-TIFF-19706243:
    - '*':
        reason: "No fix yet (REB-540). Debian's security tracker lists CVE-2026-18495 (tiff) as vulnerable for trixie on 2026-10-06, and a fresh python:3.13-slim-trixie has no newer libtiff6 to install. Look again when Debian ships a fix."
        expires: '2026-11-06T00:00:00.000Z'
exclude:
  code:
    - "projects/*/apps/*/tests/**"
    - "projects/*/packages/*/tests/**"
    - "**/e2e/**"
    - "**/*.test.ts"
    - "**/*.test.tsx"
    - "**/*.test.mjs"
    - "**/conftest.py"
    - "**/test-setup.ts"
